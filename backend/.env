ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/semantic_word_game

# "llm_judge" (uses Claude API) or "sentence_transformers" (uses local embeddings)
# IMPORTANT: If using sentence_transformers, first run: python scripts/precompute_embeddings.py
SCORING_BACKEND=sentence_transformers
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

GUESS_RATE_LIMIT_PER_MINUTE=30
