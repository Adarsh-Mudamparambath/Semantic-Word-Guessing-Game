ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/semantic_word_game

# "llm_judge" (default, no model download needed) or "sentence_transformers"
SCORING_BACKEND=llm_judge
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

GUESS_RATE_LIMIT_PER_MINUTE=30
