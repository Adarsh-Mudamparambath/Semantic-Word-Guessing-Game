ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/semantic_word_game

# Local semantic embeddings. Run python scripts/precompute_embeddings.py first.
SCORING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

GUESS_RATE_LIMIT_PER_MINUTE=30
